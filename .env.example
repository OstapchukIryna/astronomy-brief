# PostgreSQL from docker-compose
DATABASE_URL=postgresql+psycopg://astro:astro@localhost:5433/astronomy

# Test DB
TEST_DATABASE_URL=postgresql+psycopg://astro:astro@localhost:5433/astronomy_test

# DEMO_KEY allows 30 requests per hour
NASA_API_KEY=DEMO_KEY

# ollama (local) or openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_ANSWER_MAX_TOKENS=300
# OPENAI_API_KEY=sk-...
